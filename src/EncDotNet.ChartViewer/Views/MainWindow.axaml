<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EncDotNet.ChartViewer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EncDotNet.ChartViewer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EncDotNet.ChartViewer">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- Chart browser panel on the left -->
        <Border Grid.Column="0"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Button DockPanel.Dock="Top"
                        Content="{Binding IsChartsPanelExpanded, Converter={x:Static vm:PanelConverters.CollapseLabel}}"
                        Command="{Binding ToggleChartsPanelCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="4,2"
                        FontSize="11" />

                <Panel IsVisible="{Binding IsChartsPanelExpanded}"
                       Width="280">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Selected Charts"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,0,0,4" />

                        <TextBlock DockPanel.Dock="Top"
                                   Text="No charts selected."
                                   Foreground="Gray"
                                   FontStyle="Italic"
                                   Margin="0,0,0,8"
                                   IsVisible="{Binding !HasSelectedCharts}" />

                        <ItemsControl DockPanel.Dock="Top"
                                      ItemsSource="{Binding SelectedCharts}"
                                      Margin="0,0,0,8"
                                      IsVisible="{Binding HasSelectedCharts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChartViewModel}">
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right"
                                                Content="✕"
                                                Command="{Binding DeselectCommand}"
                                                FontSize="10"
                                                Padding="4,2"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Entry.Path}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border DockPanel.Dock="Top"
                                BorderBrush="#CCCCCC"
                                BorderThickness="0,0,0,1"
                                Margin="0,0,0,8" />

                        <DockPanel DockPanel.Dock="Top"
                                   Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right"
                                    Content="Manage"
                                    Command="{Binding ManageChartsCommand}"
                                    FontSize="11"
                                    Padding="6,2"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Available Charts"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBox DockPanel.Dock="Top"
                                 Text="{Binding ChartSearchText}"
                                 Watermark="Search charts..."
                                 Margin="0,0,0,8" />

                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding FilteredAvailableCharts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartViewModel}">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Content="{Binding Name}"
                                                  Margin="0,2"
                                                  ToolTip.Tip="{Binding Entry.Path}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Panel>
            </DockPanel>
        </Border>

        <!-- Map control fills the center area -->
        <mapsui:MapControl x:Name="MyMapControl" Grid.Column="1" />

        <!-- Feature layers panel on the right -->
        <Border Grid.Column="2"
                BorderBrush="#CCCCCC"
                BorderThickness="1,0,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Top"
                        Content="{Binding IsFeaturesPanelExpanded, Converter={x:Static vm:PanelConverters.CollapseLabel}}"
                        Command="{Binding ToggleFeaturesPanelCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="4,2"
                        FontSize="11" />

                <Panel IsVisible="{Binding IsFeaturesPanelExpanded}"
                       Width="220">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Chart Layers"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,0,0,8" />

                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding FeatureCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartFeatureViewModel}">
                                        <CheckBox IsChecked="{Binding IsVisible}"
                                                  Content="{Binding Name}"
                                                  Margin="0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Panel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
