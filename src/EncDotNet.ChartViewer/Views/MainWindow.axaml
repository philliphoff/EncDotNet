<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EncDotNet.ChartViewer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EncDotNet.ChartViewer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EncDotNet.ChartViewer">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- Chart browser panel on the left -->
        <Border Grid.Column="0"
                Width="280"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,1,0"
                Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Available Charts"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,8" />

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding AvailableCharts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChartViewModel}">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          Content="{Binding Name}"
                                          Margin="0,2"
                                          ToolTip.Tip="{Binding Entry.Path}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Map control fills the center area -->
        <mapsui:MapControl x:Name="MyMapControl" Grid.Column="1" />

        <!-- Feature layers panel on the right -->
        <Border Grid.Column="2"
                Width="220"
                BorderBrush="#CCCCCC"
                BorderThickness="1,0,0,0"
                Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Chart Layers"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,8" />

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding FeatureCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChartFeatureViewModel}">
                                <CheckBox IsChecked="{Binding IsVisible}"
                                          Content="{Binding Name}"
                                          Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
