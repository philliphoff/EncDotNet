<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EncDotNet.ChartViewer.ViewModels"
        xmlns:models="using:EncDotNet.ChartViewer.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EncDotNet.ChartViewer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EncDotNet.ChartViewer">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.mapZoom">
            <Setter Property="Background" Value="#B0000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Button.mapZoom:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D0000000" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.mapZoom:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0000000" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.featuresPanel">
            <Setter Property="Width" Value="0" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>
        <Style Selector="Border.featuresPanel.expanded">
            <Setter Property="Width" Value="221" />
            <Setter Property="Margin" Value="0,8,8,8" />
        </Style>
        <Style Selector="Border.chartsPanel">
            <Setter Property="Width" Value="0" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>
        <Style Selector="Border.chartsPanel.expanded">
            <Setter Property="Width" Value="281" />
            <Setter Property="Margin" Value="8,8,0,8" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Map control fills the entire area -->
        <mapsui:MapControl x:Name="MyMapControl" />

        <Canvas>
            <Border x:Name="ChartPopup"
                    IsVisible="{Binding HasHoveredChart}"
                    Background="Yellow"
                    Padding="8,4"
                    CornerRadius="0,0,0,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding HoveredChart.Name}"
                               VerticalAlignment="Center"
                               Foreground="Black"
                               FontWeight="SemiBold"
                               FontSize="12"
                               MaxWidth="160"
                               TextTrimming="CharacterEllipsis" />
                    <Button Content="{Binding HoveredChart.SelectionLabel}"
                            Command="{Binding HoveredChart.ToggleSelectedCommand}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="Black"
                            Padding="4,0"
                            MinWidth="24"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- Left side: charts panel + toggle button -->
        <Grid HorizontalAlignment="Left" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Chart browser panel (floating, slides in/out) -->
            <Border Grid.Column="0"
                    Classes="chartsPanel"
                    Classes.expanded="{Binding IsChartsPanelExpanded}"
                    Background="#E0202020"
                    CornerRadius="16"
                    VerticalAlignment="Stretch"
                    ClipToBounds="True">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseInOut" />
                        <ThicknessTransition Property="Margin" Duration="0:0:0.25" Easing="CubicEaseInOut" />
                    </Transitions>
                </Border.Transitions>
                <Panel Width="280">
                    <DockPanel Margin="12">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Selected Charts"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="0,0,0,4" />

                            <TextBlock DockPanel.Dock="Top"
                                       Text="No charts selected."
                                       Foreground="Gray"
                                       FontStyle="Italic"
                                       Margin="0,0,0,8"
                                       IsVisible="{Binding !HasSelectedCharts}" />

                            <ItemsControl DockPanel.Dock="Top"
                                          ItemsSource="{Binding SelectedCharts}"
                                          Margin="0,0,0,8"
                                          IsVisible="{Binding HasSelectedCharts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartViewModel}">
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right"
                                                    Content="✕"
                                                    Command="{Binding DeselectCommand}"
                                                    FontSize="10"
                                                    Padding="4,2"
                                                    Margin="4,0,0,0"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Entry.Path}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border DockPanel.Dock="Top"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="0,0,0,1"
                                    Margin="0,0,0,8" />

                            <DockPanel DockPanel.Dock="Top"
                                       Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right"
                                        Content="Manage"
                                        Command="{Binding ManageChartsCommand}"
                                        FontSize="11"
                                        Padding="6,2"
                                        VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right"
                                        Content="Reset"
                                        Command="{Binding ResetDataCommand}"
                                        FontSize="11"
                                        Padding="6,2"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="Available Charts"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBox DockPanel.Dock="Top"
                                     Text="{Binding ChartSearchText}"
                                     Watermark="Search charts..."
                                     Margin="0,0,0,8" />

                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding FilteredAvailableCharts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChartViewModel}">
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      Content="{Binding Name}"
                                                      Margin="0,2"
                                                      ToolTip.Tip="{Binding Entry.Path}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Panel>
            </Border>

            <!-- Charts panel toggle button -->
            <Button Grid.Column="1"
                    Classes="mapZoom"
                    Command="{Binding ToggleChartsPanelCommand}"
                    ToolTip.Tip="Toggle charts panel"
                    VerticalAlignment="Bottom"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Margin="8,0,0,8"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                <!-- Side panel icon -->
                <PathIcon Data="M3 3h18v18H3V3zm2 2v14h4V5H5zm6 0v14h8V5h-8z"
                          Width="16" Height="16" />
            </Button>
        </Grid>

        <!-- Right side: buttons + features panel -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Zoom buttons -->
            <StackPanel Grid.Column="0"
                        Orientation="Vertical"
                        Spacing="2"
                        VerticalAlignment="Top"
                        Margin="0,8,8,0">
                <Button x:Name="ZoomInButton"
                        Classes="mapZoom"
                        Content="+"
                        FontSize="18"
                        FontWeight="Bold"
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />
                <Button x:Name="ZoomOutButton"
                        Classes="mapZoom"
                        Content="−"
                        FontSize="18"
                        FontWeight="Bold"
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />
            </StackPanel>

            <!-- Layers toggle button -->
            <Button Grid.Column="0"
                    Classes="mapZoom"
                    Command="{Binding ToggleFeaturesPanelCommand}"
                    ToolTip.Tip="Toggle chart layers"
                    VerticalAlignment="Bottom"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Margin="0,0,8,8"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                <!-- Gear icon (SVG path) -->
                <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.49.49 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 00-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1112 8.4a3.6 3.6 0 010 7.2z"
                          Width="16" Height="16" />
            </Button>

            <!-- Feature layers panel (floating, slides in/out) -->
            <Border Grid.Column="1"
                    Classes="featuresPanel"
                    Classes.expanded="{Binding IsFeaturesPanelExpanded}"
                    Background="#E0202020"
                    CornerRadius="16"
                    VerticalAlignment="Stretch"
                    ClipToBounds="True">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseInOut" />
                        <ThicknessTransition Property="Margin" Duration="0:0:0.25" Easing="CubicEaseInOut" />
                    </Transitions>
                </Border.Transitions>
                <Panel Width="220">
                    <DockPanel Margin="12">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Chart Layers"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,0,0,8" />

                        <StackPanel DockPanel.Dock="Bottom"
                                    Margin="0,8,0,0">
                            <TextBlock Text="Depth Units"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding DepthUnitOptions}"
                                      SelectedItem="{Binding DepthUnit}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding FeatureCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartFeatureViewModel}">
                                        <CheckBox IsChecked="{Binding IsVisible}"
                                                  Content="{Binding Name}"
                                                  Margin="0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Panel>
            </Border>
        </Grid>

    </Grid>
</Window>
