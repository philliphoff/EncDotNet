<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EncDotNet.ChartViewer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="EncDotNet.ChartViewer.Views.ManageChartsWindow"
        x:DataType="vm:ManageChartsViewModel"
        Title="Manage Downloaded Charts"
        Width="600" Height="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:ManageChartsViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- Bottom button bar -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding ShowCancelButton}"
                        MinWidth="80" />
                <Button Content="Back"
                        Command="{Binding BackCommand}"
                        IsVisible="{Binding ShowBackButton}"
                        MinWidth="80" />
                <Button Content="Apply Changes"
                        Command="{Binding ApplyCommand}"
                        IsVisible="{Binding ShowApplyButton}"
                        IsEnabled="{Binding HasChanges}"
                        Classes="accent"
                        MinWidth="100" />
                <Button Content="Done"
                        Command="{Binding FinishCommand}"
                        IsVisible="{Binding ShowFinishButton}"
                        Classes="accent"
                        MinWidth="80" />
            </StackPanel>
        </Border>

        <!-- Step content area -->
        <Grid Margin="24,20">
            <!-- Fetching catalog step -->
            <StackPanel IsVisible="{Binding IsFetchingStep}"
                        Spacing="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="Loading Catalog"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True"
                             Margin="40,0" />
                <TextBlock Text="{Binding StatusText}"
                           HorizontalAlignment="Center"
                           Foreground="Gray" />
            </StackPanel>

            <!-- Select regions step -->
            <DockPanel IsVisible="{Binding IsSelectStep}">
                <TextBlock DockPanel.Dock="Top"
                           Text="Manage Downloaded Charts"
                           FontSize="22"
                           FontWeight="Bold" />
                <TextBlock DockPanel.Dock="Top"
                           TextWrapping="Wrap"
                           Margin="0,4,0,8"
                           Text="Check states to download charts for, uncheck to remove. Previously downloaded states are pre-selected." />

                <CheckBox DockPanel.Dock="Top"
                          IsChecked="{Binding SelectAll}"
                          Content="Select All"
                          FontWeight="SemiBold"
                          Margin="0,0,0,4" />

                <Border DockPanel.Dock="Top"
                        BorderBrush="#CCCCCC"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,4" />

                <StackPanel DockPanel.Dock="Bottom"
                            Spacing="2"
                            Margin="0,8,0,0">
                    <TextBlock Text="{Binding SelectionSummary}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ChangeSummary}"
                               Foreground="Gray"
                               FontSize="12" />
                </StackPanel>

                <ScrollViewer Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding States}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SelectableStateViewModel}">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          Content="{Binding DisplayText}"
                                          Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Applying step -->
            <StackPanel IsVisible="{Binding IsApplyingStep}"
                        Spacing="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="Applying Changes"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <ProgressBar Value="{Binding Progress}"
                             Maximum="100"
                             Margin="40,0" />
                <TextBlock Text="{Binding StatusText}"
                           HorizontalAlignment="Center"
                           Foreground="Gray" />
            </StackPanel>

            <!-- Complete step -->
            <StackPanel IsVisible="{Binding IsCompleteStep}"
                        Spacing="12"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="&#x2713;"
                           FontSize="48"
                           Foreground="Green"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Charts Updated"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PreparedChartCount, StringFormat='{}{0} chart(s) now available.'}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Click Done to return to the map."
                           Foreground="Gray"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error step -->
            <StackPanel IsVisible="{Binding IsErrorStep}"
                        Spacing="12"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="&#x26A0;"
                           FontSize="48"
                           Foreground="#E74C3C"
                           HorizontalAlignment="Center" />
                <TextBlock Text="An Error Occurred"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="400" />
                <TextBlock Text="Click Back to return and try again."
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
