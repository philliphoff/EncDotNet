{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/EncDotNet.Iso8211/EncDotNet.Iso8211.csproj",
            "src/EncDotNet.S57/EncDotNet.S57.csproj",
            "src/EncDotNet.Noaa/EncDotNet.Noaa.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "docs/**.md",
          "docs/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appLogoPath": "docs/images/logo.svg",
      "_appFaviconPath": "docs/images/logo.svg"
    }
  }
}
