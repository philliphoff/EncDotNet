{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/EncDotNet.Iso8211/EncDotNet.Iso8211.csproj",
            "src/EncDotNet.S57/EncDotNet.S57.csproj",
            "src/EncDotNet.Noaa/EncDotNet.Noaa.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "docs/**.md",
          "docs/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      },
      {
        "files": [
          "src/**/README.md",
          "src/toc.yml"
        ],
        "exclude": [
          "**/bin/**",
          "**/obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "docs/images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "docs/template"
    ],
    "globalMetadata": {
      "_appLogoPath": "docs/images/icon.svg",
      "_appFaviconPath": "docs/images/icon.svg",
      "_appName": "EncDotNet",
      "_appTitle": "EncDotNet Docs"
    }
  }
}
