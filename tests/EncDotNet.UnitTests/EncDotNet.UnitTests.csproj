<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The geometry-builder tests reference the self-contained viewer only for
         its types; the test host never runs it as an app. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Golden files: small synthetic cells written by the S-57 writers. Not real ENC data. -->
  <ItemGroup>
    <None Include="Golden\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The AML catalogue generator script's reader and writer, without its top-level program,
       tested against synthetic workbooks. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);AML_CATALOGUE_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\scripts\GenerateAmlCatalogues.cs" Link="Scripts\GenerateAmlCatalogues.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EncDotNet.Iso8211\EncDotNet.Iso8211.csproj" />
    <ProjectReference Include="..\..\src\EncDotNet.S57\EncDotNet.S57.csproj" />
    <ProjectReference Include="..\..\src\EncDotNet.ChartViewer\EncDotNet.ChartViewer.csproj" />
  </ItemGroup>

</Project>
